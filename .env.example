# Copy to .env and fill in real values

# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
PORT=5050

# Whoop OAuth (register an app at https://developer-dashboard.whoop.com)
# IMPORTANT: WHOOP_REDIRECT_URI's port must match PORT above, AND must be
# registered in your Whoop developer app's Redirect URIs list (exact match).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:5050/auth/callback

# Database
DATABASE_PATH=instance/whoop.db

# When true, the app uses seeded sample data so you can demo without Whoop creds
USE_SAMPLE_DATA=true
